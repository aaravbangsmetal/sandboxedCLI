# Vercel deployments use VERCEL_OIDC_TOKEN automatically. For local development,
# run `vercel link` and `vercel env pull apps/web/.env.local`.
# Alternatively, configure all three explicit credentials below.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Required for signing opaque sandbox workspace cookies.
# Generate with: openssl rand -base64 32
SANDBOX_SESSION_SECRET=

# Supabase owns user sessions and login history. Configure the GitHub provider
# in the Supabase dashboard; never expose the service-role key to browser code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for encrypting the GitHub provider token before database storage.
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_SCOPE=read:user user:email repo

# Optional sandbox tuning.
# Publish environments/agent to Vercel Container Registry, then set this to the
# ready repository tag printed by environments/agent/scripts/publish-vcr.sh.
SANDBOX_IMAGE=sandboxed-cli-agent:dev
SANDBOX_SESSION_TIMEOUT_MS=900000
SANDBOX_LEASE_EXTENSION_MS=300000
SANDBOX_VCPUS=2
SANDBOX_SNAPSHOT_EXPIRATION_MS=2592000000
SANDBOX_KEEP_SNAPSHOTS=1
